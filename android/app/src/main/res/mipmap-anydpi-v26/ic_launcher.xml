<?xml version="1.0" encoding="utf-8"?>
<!--
  배경은 인셋 없이 전체를 채운다. 생성 도구 기본값은 배경도 전경과 같이 16.7% 안쪽으로
  넣는데, 아이콘 아트워크는 모서리가 둥근 반면 배경 이미지는 각진 사각형이라 그 차이만큼
  배경색이 삐져나오고 바깥 테두리는 투명하게 비어 홈 화면에서 얇은 테두리 노이즈로 보였다.
  색은 아트워크 둥근 사각형 내부 가장자리의 평균색이라 이어붙은 자국이 보이지 않는다.
  (assets/icon.png 를 바꾸면 @color/ic_launcher_background 도 함께 맞출 것)
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </foreground>
</adaptive-icon>
